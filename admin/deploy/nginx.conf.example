# ========================================================
# GTICC Production Deployment Reverse Proxy (Nginx)
# ========================================================
# Replace placeholders:
#   YOUR_PUBLIC_DOMAIN  -> e.g. gticc.org
#   YOUR_ADMIN_DOMAIN   -> e.g. admin.gticc.org
# ========================================================

# 1. Public React/Vite Website (Static Assets or Container)
server {
    listen 80;
    server_name YOUR_PUBLIC_DOMAIN www.YOUR_PUBLIC_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name YOUR_PUBLIC_DOMAIN www.YOUR_PUBLIC_DOMAIN;

    ssl_certificate /etc/letsencrypt/live/YOUR_PUBLIC_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_PUBLIC_DOMAIN/privkey.pem;

    root /var/www/gticc/dist;
    index index.html;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy public API requests directly to the Next.js backend
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 2. GTICC Admin Panel
server {
    listen 80;
    server_name YOUR_ADMIN_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name YOUR_ADMIN_DOMAIN;

    ssl_certificate /etc/letsencrypt/live/YOUR_ADMIN_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_ADMIN_DOMAIN/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# NOTE: phpMyAdmin (port 8081) and MySQL (port 3307) MUST NOT be exposed here.
# Keep them bound strictly to 127.0.0.1 and access via SSH tunnel or internal VPN.

